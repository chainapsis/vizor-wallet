 @testable import Runner
 
 final class LedgerMobileHandlerTests: XCTestCase {
+  @MainActor
+  func testAuditDisconnectWithoutApduCompletionBlocksRepeatedRetry() async {
+    let transport = PendingLedgerTransport()
+    let handler = LedgerMobileHandler(transport: transport)
+    connect(handler)
+    let started = expectation(description: "APDU pending")
+    transport.onExchange = { started.fulfill() }
+    var results: [Any?] = []
+    handler.handle(FlutterMethodCall(methodName: "currentApp", arguments: nil)) { results.append($0) }
+    await fulfillment(of: [started], timeout: 2)
+    transport.simulateDisconnect()
+    for _ in 0..<20 { await Task.yield() }
+    XCTAssertEqual(results.compactMap { $0 as? FlutterError }.first?.code, "disconnected")
+    for _ in 0..<3 {
+      for method in ["disconnect", "startDiscovery"] {
+        handler.handle(FlutterMethodCall(methodName: method, arguments: nil)) { value in
+          XCTAssertEqual((value as? FlutterError)?.code, "unavailable")
+        }
+      }
+      connect(handler) { value in XCTAssertEqual((value as? FlutterError)?.code, "unavailable") }
+    }
+    XCTAssertFalse(transport.isConnected)
+    XCTAssertTrue(transport.hasPendingExchange)
+    XCTAssertEqual(transport.connects, 1)
+    XCTAssertEqual(transport.scans, 0)
+    XCTAssertEqual(transport.disconnects, 0)
+    // Test-only callback to release the continuation; a lost device supplies no such callback.
+    transport.onExchange = nil
+    transport.complete("9000")
+    for _ in 0..<20 { await Task.yield() }
+    handler.close()
+  }
+
