<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="app.vizor.bleprobe">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="32" />
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <application android:label="Vizor BLE probe" android:debuggable="true" android:directBootAware="true">
    <activity android:name="app.vizor.bleprobe.Probe" android:exported="true" android:directBootAware="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
